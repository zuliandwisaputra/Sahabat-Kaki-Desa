# Salin file ini menjadi ".env" lalu isi dengan nilai dari Supabase:
# Supabase Dashboard > Project Settings > API (atau "Connect").
# Dua nilai ini AMAN dipakai di frontend (dilindungi RLS).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key

# JANGAN taruh service role / secret key di file ini.
# Service role key hanya untuk script lokal, ditaruh di ".env.local" (lihat README).
